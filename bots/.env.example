# Telegram (create both bots with @BotFather)
TELEGRAM_TOKEN_COACH=
TELEGRAM_TOKEN_BUDDY=
# Your numeric Telegram user id. Each bot only answers this id. Leave empty on the first run:
# the bots log the id of whoever messages them so you can copy it here.
ALLOWED_USER_ID=

# Claude
ANTHROPIC_API_KEY=
# Both default to claude-opus-5-5. Override per bot if you want a cheaper model, e.g. claude-sonnet-5-5 / claude-haiku-5-5.
COACH_MODEL=claude-opus-5-5
BUDDY_MODEL=claude-opus-5-5

# Postgres. On Supabase use the Session pooler URI with the dedicated coach_bots_app role (see README).
DATABASE_URL=postgres://coach_bots_app.PROJECTREF:PASSWORD@POOLER-HOST:5432/postgres
# Tables live in this schema (keeps them apart from anything else in the database)
DB_SCHEMA=coach_bots

# Apple Health sync: the iPhone Shortcut sends this in the X-Ingest-Key header. Use a long random string.
INGEST_KEY=
PORT=3000

# Schedules (local time in TZ)
TZ_NAME=America/Toronto
BUDDY_MORNING=08:30
BUDDY_EVENING=21:00
BUDDY_QUIET_START=22:30
BUDDY_QUIET_END=08:00
BUDDY_MAX_PROACTIVE_PER_DAY=3
COACH_WEEKLY_CHECKIN=SUN 19:00
